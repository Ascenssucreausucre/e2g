// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  state     PlayerState?
  stateId   String?
}

model PlayerState {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  nodeId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completedChapters Chapter[]
  affinities Affinity[]
}

model Affinity {
  id            String      @id @default(uuid())
  playerStateId String
  characterId   Int
  value         Int         @default(0)

  playerState   PlayerState @relation(fields: [playerStateId], references: [id])
  character     Character   @relation(fields: [characterId], references: [id])
  @@unique([playerStateId, characterId])
}

model Character {
  id          Int @id @default(autoincrement())
  name        String
  description String?
  portrait    String?

  chapters Chapter[] @relation("ChapterCharacters")
  affinities Affinity[]
}

model Chapter {
  id      Int @id @default(autoincrement())
  title   String
  startCharacterIds String?
  order   String?
  cost    Int     @default(0)
  active  Boolean @default(true)

  characters Character[] @relation("ChapterCharacters")
  dialogue DialogueData[]
  completedBy PlayerState[]
}

model DialogueData {
  id String @id @default(uuid())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  content   Json
}